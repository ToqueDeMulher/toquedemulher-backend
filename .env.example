DATABASE_URL=
SECRET_KEY=
CREATE_TABLES_ON_STARTUP=false
# auto uses NullPool on Vercel and Supabase transaction poolers (port 6543).
DB_POOL_MODE=auto
DB_CONNECT_TIMEOUT=10
DB_POOL_TIMEOUT=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_SUCCESS_URL=http://localhost:5173/checkout/success
FRONTEND_PENDING_URL=http://localhost:5173/checkout/pending
FRONTEND_FAILURE_URL=http://localhost:5173/checkout/failure
GOOGLE_CLIENT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Toque de Mulher
CONTACT_RECIPIENT_EMAIL=
# Only set after the store confirms this can be published.
STORE_CONTACT_EMAIL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=http://localhost:8000/api/v1/shipping/oauth/callback
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_SENDER={}
MELHOR_ENVIO_SERVICES=1,2,3,4
# 0 disables free shipping; use the threshold confirmed by the store.
MELHOR_ENVIO_FREE_SHIPPING_THRESHOLD=0
